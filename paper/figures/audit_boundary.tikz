\begin{tikzpicture}[
  x=1cm,
  y=1cm,
  >=Stealth,
  header/.style={
    font=\sffamily\scriptsize\bfseries,
    text=arenaGray!88!black,
    align=center
  },
  panel/.style={
    rounded corners=3pt,
    draw=arenaInk!20,
    fill=arenaLight,
    line width=.35pt
  },
  card/.style={
    rounded corners=2pt,
    draw=arenaInk!42,
    fill=white,
    line width=.45pt,
    align=center,
    inner xsep=3pt,
    inner ysep=2.4pt,
    font=\sffamily\scriptsize
  },
  bluecard/.style={card, draw=arenaBlue!62, fill=arenaBlue!6},
  greencard/.style={card, draw=arenaGreen!68!black, fill=arenaGreen!6},
  redcard/.style={card, draw=arenaRed!75!black, fill=arenaRed!6},
  rule/.style={
    rounded corners=1.5pt,
    draw=arenaInk!24,
    fill=white,
    line width=.32pt,
    font=\sffamily\tiny,
    align=left,
    inner xsep=3.5pt,
    inner ysep=2.2pt
  },
  wire/.style={draw=arenaInk!70, line width=.5pt},
  arrow/.style={wire, -{Stealth[length=3.6pt,width=4.4pt]}},
  note/.style={font=\sffamily\scriptsize, text=arenaGray!90!black, align=center}
]

% Four groups on evenly spaced centres: 1.25, 4.25, 8.15, 12.15 (gaps ~1.6).
\path[use as bounding box] (-.05,-1.52) rectangle (13.42,1.66);

% panels
\node[panel, minimum width=2.04cm, minimum height=2.36cm] at (1.25,0) {};
\node[panel, minimum width=3.34cm, minimum height=2.36cm] (contract) at (8.15,0) {};
\node[panel, minimum width=2.06cm, minimum height=2.36cm] at (12.15,0) {};

\node[header] at (1.25,1.32) {frozen evidence};
\node[header] at (8.15,1.32) {deterministic contract};
\node[header] at (12.15,1.32) {review artifact};

% inputs
\node[bluecard, text width=1.52cm] (scenario) at (1.25,.50)
  {$\sigma$ scenario\\[1pt]{\tiny cash, holdings,\\universe, facts}};
\node[bluecard, text width=1.52cm] (reply) at (1.25,-.50)
  {$r$ reply\\[1pt]{\tiny tickers, dollars,\\citations}};

% parse
\node[greencard, text width=1.28cm] (parse) at (4.25,0)
  {parse $r{\to}a$\\[1pt]{\tiny typed action}};

% contract content
\node[header, text=arenaGreen!50!black] at (8.15,.86)
  {$C(\sigma,a)$ holds iff every row holds};
\node[rule, text width=2.86cm] (admissible) at (8.15,.40)
  {\textbf{Admissible:} universe, cap, cash};
\node[rule, text width=2.86cm, draw=arenaRed!55!black, fill=arenaRed!6] (economic) at (8.15,0)
  {\textbf{Economic:} floor, split, fee};
\node[rule, text width=2.86cm] (grounded) at (8.15,-.40)
  {\textbf{Grounded:} facts, replay hash};
\node[note] at (8.15,-.86) {decided before any return};

% outputs
\node[greencard, text width=1.5cm] (pass) at (12.15,.74)
  {PASS\\[1pt]{\tiny executable orders}};
\node[redcard, text width=1.5cm] (fail) at (12.15,0)
  {FAIL\\[1pt]{\tiny typed violation}};
\node[card, text width=1.5cm] (metrics) at (12.15,-.74)
  {$V,\,S,\,S_w,\,A$\\[1pt]{\tiny audit metrics}};

% input merge: scenario + reply -> short stub -> long arrow to parse
\draw[wire] (scenario.east) -- (2.30,.50);
\draw[wire] (reply.east) -- (2.30,-.50);
\draw[wire] (2.30,.50) -- (2.30,-.50);
\draw[arrow] (2.30,0) -- (parse.west);

% parse -> contract
\draw[arrow] (parse.east) -- (contract.west);

% output branch: contract -> short stub -> long arrows to PASS / FAIL / metrics
\draw[wire] (contract.east) -- (10.12,0);
\draw[wire] (10.12,.74) -- (10.12,-.74);
\draw[arrow] (10.12,.74) -- (pass.west);
\draw[arrow] (10.12,0) -- (fail.west);
\draw[arrow] (10.12,-.74) -- (metrics.west);
\end{tikzpicture}
