\begin{tikzpicture}[
  x=1cm,
  y=1cm,
  >=Stealth,
  header/.style={
    font=\sffamily\tiny\bfseries,
    text=arenaGray!88!black,
    align=center
  },
  panel/.style={
    rounded corners=3pt,
    draw=arenaInk!20,
    fill=arenaLight,
    line width=.35pt
  },
  card/.style={
    rounded corners=2pt,
    draw=arenaInk!42,
    fill=white,
    line width=.45pt,
    align=left,
    inner xsep=4pt,
    inner ysep=3pt,
    font=\sffamily\scriptsize
  },
  bluecard/.style={card, draw=arenaBlue!62, fill=arenaBlue!6},
  greencard/.style={card, draw=arenaGreen!68!black, fill=arenaGreen!6},
  redcard/.style={card, draw=arenaRed!75!black, fill=arenaRed!6},
  rule/.style={
    rounded corners=1.5pt,
    draw=arenaInk!24,
    fill=white,
    line width=.32pt,
    font=\sffamily\tiny,
    align=left,
    inner xsep=3pt,
    inner ysep=1.8pt
  },
  arrow/.style={-{Stealth[length=3.3pt,width=4.1pt]}, draw=arenaInk!72, line width=.55pt},
  faintarrow/.style={-{Stealth[length=3pt,width=3.7pt]}, draw=arenaGray!55, line width=.45pt},
  note/.style={font=\sffamily\tiny, text=arenaGray!90!black, align=center}
]

\path[use as bounding box] (-.05,-1.22) rectangle (7.55,1.55);

\node[panel, minimum width=1.74cm, minimum height=2.30cm] at (.88,.08) {};
\node[panel, minimum width=3.18cm, minimum height=2.30cm] at (3.78,.08) {};
\node[panel, minimum width=1.48cm, minimum height=2.30cm] at (6.74,.08) {};

\node[header] at (.88,1.31) {frozen evidence};
\node[header] at (3.78,1.31) {deterministic contract};
\node[header] at (6.74,1.31) {review artifact};

\node[bluecard, text width=1.34cm] (scenario) at (.88,.57)
  {$\sigma$ scenario\\[-1pt]\scriptsize cash, holdings\\universe, facts};
\node[bluecard, text width=1.34cm] (reply) at (.88,-.47)
  {$r$ reply\\[-1pt]\scriptsize tickers, dollars\\citations};

\node[greencard, text width=.92cm, align=center] (parse) at (2.25,.05)
  {$a=\mathrm{parse}(r)$\\[-1pt]\scriptsize typed action};

\node[header, text=arenaGreen!55!black] at (3.85,.91)
  {$C(\sigma,a)$: pass iff all rows hold};
\node[rule, text width=2.06cm] (admissible) at (3.86,.48)
  {\textbf{Admissible:} universe, cap, cash};
\node[rule, text width=2.06cm, draw=arenaRed!60!black, fill=arenaRed!6] (economic) at (3.86,.05)
  {\textbf{Economic:} floor, split, fee};
\node[rule, text width=2.06cm] (grounded) at (3.86,-.38)
  {\textbf{Grounded:} facts, replay hash};
\node[note] at (3.86,-.86) {decided before returns};

\coordinate (contractin) at (2.92,.05);
\coordinate (contractout) at (4.98,.05);

\node[greencard, text width=1.12cm, align=center] (pass) at (6.74,.64)
  {PASS\\[-1pt]\scriptsize executable\\orders};
\node[redcard, text width=1.12cm, align=center] (fail) at (6.74,-.13)
  {FAIL\\[-1pt]\scriptsize typed\\violation};
\node[card, text width=1.12cm, align=center] (metrics) at (6.74,-.78)
  {$V,S,S_w,A$\\[-1pt]\scriptsize metrics};

\draw[arrow] (scenario.east) -- (parse.west);
\draw[arrow] (reply.east) -- (parse.west);
\draw[arrow] (parse.east) -- (contractin);
\draw[arrow] (contractout) -- (pass.west);
\draw[arrow] (contractout) -- (fail.west);
\draw[faintarrow] (pass.south) -- (metrics.north);
\draw[faintarrow] (fail.south) -- (metrics.north);
\end{tikzpicture}
