\begin{tikzpicture}[
  x=1cm,
  y=1cm,
  >=Stealth,
  header/.style={
    font=\sffamily\tiny\bfseries,
    text=arenaGray!88!black,
    align=center
  },
  panel/.style={
    rounded corners=3pt,
    draw=arenaInk!20,
    fill=arenaLight,
    line width=.35pt
  },
  card/.style={
    rounded corners=2pt,
    draw=arenaInk!42,
    fill=white,
    line width=.45pt,
    align=center,
    inner xsep=3pt,
    inner ysep=2.4pt,
    font=\sffamily\scriptsize
  },
  bluecard/.style={card, draw=arenaBlue!62, fill=arenaBlue!6},
  greencard/.style={card, draw=arenaGreen!68!black, fill=arenaGreen!6},
  redcard/.style={card, draw=arenaRed!75!black, fill=arenaRed!6},
  rule/.style={
    rounded corners=1.5pt,
    draw=arenaInk!24,
    fill=white,
    line width=.32pt,
    font=\sffamily\tiny,
    align=left,
    inner xsep=3pt,
    inner ysep=1.9pt
  },
  arrow/.style={-{Stealth[length=3.3pt,width=4.1pt]}, draw=arenaInk!72, line width=.55pt},
  faintarrow/.style={-{Stealth[length=3pt,width=3.7pt]}, draw=arenaGray!55, line width=.45pt},
  note/.style={font=\sffamily\tiny, text=arenaGray!90!black, align=center}
]

\path[use as bounding box] (-.08,-1.46) rectangle (9.42,1.74);

% panels
\node[panel, minimum width=1.94cm, minimum height=2.58cm] at (.97,0) {};
\node[panel, minimum width=3.46cm, minimum height=2.58cm] (contract) at (5.42,0) {};
\node[panel, minimum width=1.96cm, minimum height=2.58cm] at (8.32,0) {};

\node[header] at (.97,1.52) {frozen evidence};
\node[header] at (5.42,1.52) {deterministic contract};
\node[header] at (8.32,1.52) {review artifact};

% inputs
\node[bluecard, text width=1.50cm] (scenario) at (.97,.56)
  {$\sigma$ scenario\\[1pt]{\tiny cash, holdings,\\universe, facts}};
\node[bluecard, text width=1.50cm] (reply) at (.97,-.58)
  {$r$ reply\\[1pt]{\tiny tickers, dollars,\\citations}};

% parse, centered in the gap between the two left panels
\node[greencard, text width=1.18cm] (parse) at (2.85,0)
  {parse $r{\to}a$\\[1pt]{\tiny typed action}};

% contract content
\node[header, text=arenaGreen!50!black] at (5.42,.93)
  {$C(\sigma,a)$ holds iff every row holds};
\node[rule, text width=2.64cm] (admissible) at (5.42,.46)
  {\textbf{Admissible:} universe, cap, cash};
\node[rule, text width=2.64cm, draw=arenaRed!55!black, fill=arenaRed!6] (economic) at (5.42,.04)
  {\textbf{Economic:} floor, split, fee};
\node[rule, text width=2.64cm] (grounded) at (5.42,-.38)
  {\textbf{Grounded:} facts, replay hash};
\node[note] at (5.42,-.85) {decided before any return};

% outputs
\node[greencard, text width=1.46cm] (pass) at (8.32,.62)
  {PASS\\[1pt]{\tiny executable orders}};
\node[redcard, text width=1.46cm] (fail) at (8.32,-.18)
  {FAIL\\[1pt]{\tiny typed violation}};
\node[card, text width=1.46cm] (metrics) at (8.32,-.92)
  {$V,\,S,\,S_w,\,A$\\[1pt]{\tiny audit metrics}};

% flow: inputs -> parse -> contract edge -> verdicts -> metrics
\draw[arrow] (scenario.east) -- (parse.north west);
\draw[arrow] (reply.east) -- (parse.south west);
\draw[arrow] (parse.east) -- (contract.west);
\draw[arrow] (contract.east) -- (pass.west);
\draw[arrow] (contract.east) -- (fail.west);
\draw[faintarrow] (pass.south) -- (metrics.north);
\draw[faintarrow] (fail.south) -- (metrics.north);
\end{tikzpicture}
